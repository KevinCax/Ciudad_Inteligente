# Configuracion del despliegue. Copiar a .env y completar.
#
#   cp deploy/.env.example deploy/.env
#
# El archivo .env NO se versiona: contiene credenciales y la llave de
# tokenizacion de placas.

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Desarrollo (Postgres local levantado con docker-compose.dev.yml):
DATABASE_URL=postgres://ciudad:ciudad@postgres:5432/ciudades?sslmode=disable

# Produccion (base gestionada en la nube). Usar sslmode=require:
# DATABASE_URL=postgres://usuario:password@host.proveedor.com:5432/ciudades?sslmode=require

POSTGRES_USER=ciudad
POSTGRES_PASSWORD=ciudad
POSTGRES_DB=ciudades

# ---------------------------------------------------------------------------
# Privacidad
# ---------------------------------------------------------------------------
# Llave HMAC con la que el ingestor tokeniza la placa vehicular antes de
# persistirla en la nube. Se custodia on-premise.
#   Generar con: openssl rand -hex 32
# Si se deja vacia, las placas se guardan en claro y los servicios lo advierten
# en el arranque. Para la demo debe ir con valor.
PLATE_HMAC_KEY=

# ---------------------------------------------------------------------------
# Autenticacion de los servicios
# ---------------------------------------------------------------------------
# Vacios dejan los endpoints abiertos; los servicios lo advierten al arrancar.
INGESTOR_API_KEY=
CORRELATOR_API_TOKEN=

# ---------------------------------------------------------------------------
# Archivado (persister)
# ---------------------------------------------------------------------------
# Un lote se cierra por volumen o por tiempo, lo que ocurra primero.
BATCH_SIZE=100
BATCH_TIMEOUT=2s
PERSISTER_CONSUMER_GROUP=persister
INDEXER_CONSUMER_GROUP=indexer

# ---- Aviso a terceros (ADR-011) ----
NOTIFIER_CONSUMER_GROUP=notifier

# Canal de entrega: "simulado" o "webhook".
#
# ATENCION: con "simulado" los avisos se REGISTRAN pero NO se entregan. No hay
# integracion con bomberos, policia ni ambulancias: el sistema documenta a
# quien habria que avisar y deja la trazabilidad completa, pero nadie acude.
# Es el valor por defecto y conviene no perderlo de vista al demostrarlo.
NOTIFIER_CANAL=simulado
NOTIFIER_WEBHOOK_URL=
NOTIFIER_WEBHOOK_TIMEOUT=5s

# Matriz de despacho. Vacio = rige la de fabrica, que es:
#   fire                    -> bomberos,ambulancia
#   accident                -> ambulancia,policia,transito
#   possible_robbery        -> policia
#   traffic_speed_violation -> transito
#   vehicle_pursuit         -> policia,transito
#
# Para silenciar un tipo a proposito se escribe "ninguno". NO se usa el valor
# vacio para eso: vacio significa "no configurado", de modo que un .env a
# medio rellenar no pueda dejar los incendios sin aviso en silencio.
DISPATCH_FIRE=
DISPATCH_ACCIDENT=
DISPATCH_POSSIBLE_ROBBERY=
DISPATCH_TRAFFIC_SPEED_VIOLATION=
DISPATCH_VEHICLE_PURSUIT=

# ---- Tareas periodicas (ADR-009) ----
TZ_TAREAS=America/Guatemala
HORA_AGREGADOS=03:00
HORA_RETENCION=03:30
RETENCION_DIAS_PLACA=90
RETENCION_DIAS_COORDENADAS=365
RETENCION_DIAS_BORRADO=730
RETENCION_MESES_INDICES=12

# ---- Recorridos por calle (ADR-012) ----
#
# El motor de rutas vive en la capa de borde: traza el camino mas probable
# entre los puntos donde una camara vio un vehiculo. Prepare el mapa UNA vez
# con "./make.sh rutas-preparar" antes de levantarlo.
OSRM_URL=http://osrm:5000
OSRM_HOST_PORT=5001
INTERVALO_RUTAS=1m
RUTAS_HORAS_ATRAS=48
JOBS_API_TOKEN=
ELASTICSEARCH_URL=http://elasticsearch:9200

# Ventana durante la cual el ingestor recuerda un event_id ya aceptado.
DEDUPE_TTL=24h

# ---------------------------------------------------------------------------
# Correlacion
# ---------------------------------------------------------------------------
PARTITION_KEY_STRATEGY=zone
CORRELATION_SEEN_TTL=10m
CORRELATION_WINDOW_TTL=15m
ALERT_SUPPRESS_TTL=5m
RULE_VERSION=1.0

# ---- Correlacion por vehiculo (regla de persecucion) ----
#
# Ventana en la que Redis conserva las apariciones de un mismo vehiculo. Debe
# ser al menos tan larga como RULE_VENTANA_PERSECUCION.
VEHICLE_WINDOW_TTL=30m

# Plazo durante el cual se encadenan las infracciones de un mismo coche, y
# cuantas hacen falta para hablar de huida.
#
# RULE_VENTANA_PERSECUCION NO puede superar CORRELATION_WINDOW_TTL: el boton de
# panico que ancla la regla vive en la ventana de ZONA, de modo que mirar mas
# atras seria buscar un evento que Redis ya podo. El correlator comprueba la
# relacion al arrancar y se niega a seguir si no se cumple.
RULE_VENTANA_PERSECUCION=15m
RULE_MIN_INFRACCIONES_PERSECUCION=2

# Velocidad media maxima, en km/h, que se admite entre dos apariciones
# consecutivas de un mismo vehiculo. Por encima, el enlace se descarta: no es
# un coche rapido, es una placa mal leida o clonada. Sin este techo el motor
# encadena una lectura de la zona 10 con otra de la zona 6 dos segundos
# despues, que serian 6.57 km a casi doce mil km/h.
RULE_VELOCIDAD_MAXIMA_PLAUSIBLE=70

# Grupo de consumo. Cada servicio usa el suyo para leer el flujo completo;
# compartir grupo haria que se repartieran las particiones en lugar de que
# cada uno viera todos los eventos.
KAFKA_CONSUMER_GROUP=correlator
KAFKA_CONSUME_FROM_START=false

# Puerto con el que el correlator se publica en el HOST. Dentro de Docker
# sigue siendo 8080 pase lo que pase aqui; esto solo evita chocar con otro
# programa que ya ocupe ese puerto en la maquina.
#
# Puertos ya tomados por el despliegue, por si hay que cambiarlo: 8000, 8002,
# 8003 y 8004 (microservicios), 8081 (Kafka-UI), 3000 (Grafana), 9090
# (Prometheus), 9092 (Kafka), 6379 (Redis), 5432 (PostgreSQL), 9200
# (Elasticsearch), 5601 (Kibana).
CORRELATOR_HOST_PORT=8001

# ---------------------------------------------------------------------------
# Observabilidad
# ---------------------------------------------------------------------------
LOG_LEVEL=info
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

GRAFANA_PG_HOST=postgres:5432
GRAFANA_PG_DATABASE=ciudades
GRAFANA_PG_USER=ciudad
GRAFANA_PG_PASSWORD=ciudad
GRAFANA_PG_SSLMODE=disable
