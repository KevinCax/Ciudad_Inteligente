# Configuracion del despliegue. Copiar a .env y completar.
#
#   cp deploy/.env.example deploy/.env
#
# El archivo .env NO se versiona: contiene credenciales y la llave de
# tokenizacion de placas.

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Desarrollo (Postgres local levantado con docker-compose.dev.yml):
DATABASE_URL=postgres://ciudad:ciudad@postgres:5432/ciudades?sslmode=disable

# Produccion (base gestionada en la nube). Usar sslmode=require:
# DATABASE_URL=postgres://usuario:password@host.proveedor.com:5432/ciudades?sslmode=require

POSTGRES_USER=ciudad
POSTGRES_PASSWORD=ciudad
POSTGRES_DB=ciudades

# ---------------------------------------------------------------------------
# Privacidad
# ---------------------------------------------------------------------------
# Llave HMAC con la que el ingestor tokeniza la placa vehicular antes de
# persistirla en la nube. Se custodia on-premise.
#   Generar con: openssl rand -hex 32
# Si se deja vacia, las placas se guardan en claro y los servicios lo advierten
# en el arranque. Para la demo debe ir con valor.
PLATE_HMAC_KEY=

# ---------------------------------------------------------------------------
# Autenticacion de los servicios
# ---------------------------------------------------------------------------
# Vacios dejan los endpoints abiertos; los servicios lo advierten al arrancar.
INGESTOR_API_KEY=
CORRELATOR_API_TOKEN=

# ---------------------------------------------------------------------------
# Archivado (persister)
# ---------------------------------------------------------------------------
# Un lote se cierra por volumen o por tiempo, lo que ocurra primero.
BATCH_SIZE=100
BATCH_TIMEOUT=2s
PERSISTER_CONSUMER_GROUP=persister-go
INDEXER_CONSUMER_GROUP=indexer-go

# ---- Tareas periodicas (ADR-009) ----
TZ_TAREAS=America/Guatemala
HORA_AGREGADOS=03:00
HORA_RETENCION=03:30
RETENCION_DIAS_PLACA=90
RETENCION_DIAS_COORDENADAS=365
RETENCION_DIAS_BORRADO=730
RETENCION_MESES_INDICES=12
JOBS_API_TOKEN=
ELASTICSEARCH_URL=http://elasticsearch:9200

# Ventana durante la cual el ingestor recuerda un event_id ya aceptado.
DEDUPE_TTL=24h

# ---------------------------------------------------------------------------
# Correlacion
# ---------------------------------------------------------------------------
PARTITION_KEY_STRATEGY=zone
CORRELATION_SEEN_TTL=10m
CORRELATION_WINDOW_TTL=10m
ALERT_SUPPRESS_TTL=5m
RULE_VERSION=1.0

# Grupo de consumo. Durante la migracion en paralelo el correlator Java y el
# Go usan grupos distintos para leer el mismo topic sin robarse offsets.
KAFKA_CONSUMER_GROUP=correlator-go
KAFKA_CONSUME_FROM_START=false

# ---------------------------------------------------------------------------
# Observabilidad
# ---------------------------------------------------------------------------
LOG_LEVEL=info
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

GRAFANA_PG_HOST=postgres:5432
GRAFANA_PG_DATABASE=ciudades
GRAFANA_PG_USER=ciudad
GRAFANA_PG_PASSWORD=ciudad
GRAFANA_PG_SSLMODE=disable
