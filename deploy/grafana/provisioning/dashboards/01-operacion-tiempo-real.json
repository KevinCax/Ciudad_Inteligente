{
  "uid": "ciudad-operacion",
  "title": "Ciudad Inteligente — Operacion en tiempo real",
  "description": "Flujo de eventos y alertas segun las metricas que exponen los cinco microservicios. Es el tablero de la jornada de simulacion.",
  "tags": [
    "ciudad-inteligente",
    "tiempo-real"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "zona",
        "label": "Zona",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-ciudad"
        },
        "definition": "label_values(ingestor_events_ingested_total, zone)",
        "query": {
          "query": "label_values(ingestor_events_ingested_total, zone)",
          "refId": "zona"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1,
        "options": [],
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Eventos por segundo",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ciudad"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ciudad"
          },
          "expr": "sum(rate(ingestor_events_ingested_total{zone=~\"$zona\"}[5m]))",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "unit": "ops",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "description": "Ritmo de ingesta aceptada. El volumen estimado en operacion es de 20 a 100 ev/s."
