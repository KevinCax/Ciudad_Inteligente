          "rawSql": "SELECT created_at   AS \"Hora\",\n       type         AS \"Tipo de alerta\",\n       zone         AS \"Zona\",\n       round(score, 2) AS \"Confianza\",\n       window_start AS \"Inicio de ventana\",\n       window_end   AS \"Fin de ventana\",\n       jsonb_array_length(evidence) AS \"Evidencias\",\n       correlation_id AS \"Correlacion\"\nFROM alerts\nWHERE $__timeFilter(created_at) AND zone LIKE '$zona'\nORDER BY created_at DESC\nLIMIT 200"
