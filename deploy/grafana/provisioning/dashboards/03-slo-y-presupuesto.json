{
  "uid": "ciudad-slo",
  "title": "Ciudad Inteligente — SLO y presupuesto de error",
  "description": "Cumplimiento de los objetivos de nivel de servicio del ADR-008 y consumo del presupuesto de error.",
  "tags": [
    "ciudad-inteligente",
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 201,
      "type": "stat",
      "title": "Cumplimiento del SLO de deteccion (30 dias)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ciudad"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ciudad"
          },
          "expr": "sum(increase(correlator_correlation_latency_seconds_bucket{le=~\"2(\\\\.0)?\"}[30d]))\n/\nsum(increase(correlator_correlation_latency_seconds_count[30d]))",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.985
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "description": "Objetivo: el 99% de las alertas generadas en menos de 2 s desde el timestamp del evento disparador."
    },
    {
      "id": 202,
      "type": "gauge",
      "title": "Presupuesto de error consumido",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ciudad"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ciudad"
          },
          "expr": "(\n  (\n    sum(increase(correlator_correlation_latency_seconds_count[30d]))\n    -\n    sum(increase(correlator_correlation_latency_seconds_bucket{le=~\"2(\\\\.0)?\"}[30d]))\n  )\n  /\n  sum(increase(correlator_correlation_latency_seconds_count[30d]))\n) / 0.01",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "minVizWidth": 75,
        "minVizHeight": 75,
        "sizing": "auto"
      },
      "description": "Por debajo del 50% se despliega con normalidad. Entre 50% y 100% se congelan los cambios no esenciales. Por encima del 100% se escala a coordinacion. (ADR-008)"
    },
    {
      "id": 203,
      "type": "stat",
      "title": "Latencia media de deteccion (1 h)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ciudad"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ciudad"
          },
          "expr": "sum(rate(correlator_correlation_latency_seconds_sum[1h]))\n/\nsum(rate(correlator_correlation_latency_seconds_count[1h]))",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "unit": "s",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "description": "Medicion de referencia del proyecto: 44 ms."
    },
    {
      "id": 204,
      "type": "timeseries",
      "title": "Latencia de deteccion: p50, p95 y p99",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ciudad"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ciudad"
          },
          "expr": "histogram_quantile(0.50, sum(rate(correlator_correlation_latency_seconds_bucket[$__rate_interval])) by (le))",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ciudad"
          },
          "expr": "histogram_quantile(0.95, sum(rate(correlator_correlation_latency_seconds_bucket[$__rate_interval])) by (le))",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ciudad"
          },
          "expr": "histogram_quantile(0.99, sum(rate(correlator_correlation_latency_seconds_bucket[$__rate_interval])) by (le))",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "scaleDistribution": {
              "type": "linear"
            },
            "axisPlacement": "auto",
            "gradientMode": "opacity",
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "La linea roja en 2 s es el umbral del SLO. LatenciaDeteccionDegradandose avisa cuando el p95 supera 1 s, es decir, la mitad del margen."
    },
    {
      "id": 205,
