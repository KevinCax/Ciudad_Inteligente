# ---- HTTP (API de gestion) ----
SERVER_PORT=8080
SHUTDOWN_TIMEOUT=15s

# ---- Kafka (on-premise / LAN) ----
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_EVENTS=events.standardized
KAFKA_TOPIC_ALERTS=correlated.alerts
KAFKA_TOPIC_DLQ=events.dlq
# Group id propio: permite correr el correlator Go en paralelo con el Java
# sobre el mismo topic sin que se roben offsets entre si.
KAFKA_CONSUMER_GROUP=correlator-go

# ---- Redis (ventanas de correlacion) ----
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- PostgreSQL (nube) ----
DATABASE_URL=postgres://usuario:password@host:5432/ciudades?sslmode=require

# ---- Correlacion ----
CORRELATION_SEEN_TTL=10m
CORRELATION_WINDOW_TTL=10m
# Evita la cascada de alertas duplicadas: una vez emitida una alerta de un
# tipo en una zona, no se vuelve a emitir hasta que expire este TTL.
ALERT_SUPPRESS_TTL=5m
RULE_VERSION=1.0

# ---- Seguridad ----
API_TOKEN=

# ---- Observabilidad ----
LOG_LEVEL=info
LOG_FORMAT=json
ENVIRONMENT=development

# Migracion en paralelo: leer desde el offset mas antiguo para reprocesar
# el mismo historico que el correlator Java y comparar salidas.
# En operacion normal debe quedar en false.
KAFKA_CONSUME_FROM_START=false
