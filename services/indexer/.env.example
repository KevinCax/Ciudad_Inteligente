# ---- HTTP (solo salud y metricas) ----
SERVER_PORT=8003
SHUTDOWN_TIMEOUT=30s

# ---- Kafka (on-premise / LAN) ----
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_EVENTS=events.standardized
KAFKA_TOPIC_ALERTS=correlated.alerts
KAFKA_TOPIC_DLQ=events.dlq
KAFKA_CONSUMER_GROUP=indexer-go
# Grupo propio, independiente del persister: el archivo autoritativo y el
# indice de busqueda avanzan a su ritmo y un atasco en uno no frena al otro.
KAFKA_CONSUME_FROM_START=true

# ---- Elasticsearch (nube) ----
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=

# ---- Lote ----
BATCH_SIZE=100
BATCH_TIMEOUT=2s

# ---- Privacidad ----
# El indexer escribe fuera de la LAN, asi que tokeniza la placa igual que el
# persister. Debe usar LA MISMA llave: si difieren, el mismo vehiculo tendria
# seudonimos distintos en PostgreSQL y en Elasticsearch, y las busquedas
# cruzadas entre ambos dejarian de funcionar.
PLATE_HMAC_KEY=

# ---- Observabilidad ----
LOG_LEVEL=info
LOG_FORMAT=json
ENVIRONMENT=development
