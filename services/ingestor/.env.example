# ---- HTTP ----
SERVER_PORT=8000
SHUTDOWN_TIMEOUT=15s

# ---- Kafka (on-premise / LAN) ----
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_EVENTS=events.standardized
KAFKA_TOPIC_DLQ=events.dlq

# ---- Redis (deduplicacion, on-premise / LAN) ----
# El ingestor NO habla con la base de datos: el archivado lo hace el servicio
# persister. Todas sus dependencias estan en la LAN, de modo que una caida del
# enlace a internet no detiene la ingesta.
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
# Ventana durante la cual se recuerda un event_id ya aceptado.
DEDUPE_TTL=24h

# ---- Dominio ----
# zone       -> afinidad por zona, recomendado (enunciado, seccion 4)
# event_type -> la alternativa descartada: solo cinco valores posibles para
#               tres particiones, reparto desbalanceado y perdida del orden
#               relativo dentro de cada zona
PARTITION_KEY_STRATEGY=zone

# ---- Seguridad ----
# Si se deja vacia, los endpoints de ingesta quedan abiertos y el servicio
# lo advierte en el arranque. En la demo debe ir con valor.
API_KEY=

# ---- Observabilidad ----
LOG_LEVEL=info
LOG_FORMAT=json
ENVIRONMENT=development
