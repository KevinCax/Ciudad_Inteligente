# ---- HTTP ----
SERVER_PORT=8004
SHUTDOWN_TIMEOUT=60s

# ---- Horario ----
# Zona horaria en la que se interpretan las horas de las tareas. Importa: una
# purga a las 03:00 debe correr de madrugada en Guatemala, no en UTC.
TZ_TAREAS=America/Guatemala

# Los agregados corren ANTES que la retencion a proposito: si la purga borrara
# los eventos primero, el resumen del dia saldria incompleto, y esa perdida es
# irreversible porque el agregado es justamente lo que sobrevive al borrado.
HORA_AGREGADOS=03:00
HORA_RETENCION=03:30

# ---- PostgreSQL (nube) ----
DATABASE_URL=postgres://usuario:password@host:5432/ciudades?sslmode=require

# ---- Redis (cerrojo distribuido, LAN) ----
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Elasticsearch (opcional) ----
# Si se deja vacio, o si no responde, la purga de indices se omite pero la
# retencion en PostgreSQL sigue aplicandose.
ELASTICSEARCH_URL=http://elasticsearch:9200

# ---- Politica de retencion (ADR-007) ----
# El dato pierde capacidad de identificar conforme envejece:
#   90 dias  -> se elimina el seudonimo de la placa
#   365 dias -> se eliminan las coordenadas; se conserva la zona
#   730 dias -> se borra el evento; queda el agregado diario
RETENCION_DIAS_PLACA=90
RETENCION_DIAS_COORDENADAS=365
RETENCION_DIAS_BORRADO=730
RETENCION_MESES_INDICES=12

# ---- Seguridad ----
# Lanzar la retencion a mano borra informacion de forma irreversible.
API_TOKEN=

# ---- Observabilidad ----
LOG_LEVEL=info
LOG_FORMAT=json
ENVIRONMENT=development
