# ---- HTTP (solo salud y metricas) ----
SERVER_PORT=8002
SHUTDOWN_TIMEOUT=30s

# ---- Kafka (on-premise / LAN) ----
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_EVENTS=events.standardized
KAFKA_TOPIC_DLQ=events.dlq
KAFKA_CONSUMER_GROUP=persister-go
# true por defecto, al reves que en el correlator: reprocesar un evento ya
# archivado es inofensivo (ON CONFLICT DO NOTHING), pero no archivarlo deja un
# hueco permanente en el historico.
KAFKA_CONSUME_FROM_START=true

# ---- PostgreSQL (nube) ----
DATABASE_URL=postgres://usuario:password@host:5432/ciudades?sslmode=require
DB_MAX_CONNS=10

# ---- Lote ----
# Un lote se cierra por volumen o por tiempo, lo que ocurra primero. El limite
# por tiempo evita que un evento espere indefinidamente cuando baja el trafico.
BATCH_SIZE=100
BATCH_TIMEOUT=2s

# ---- Privacidad ----
# Llave HMAC con la que se tokeniza la placa ANTES de que el dato cruce hacia
# la nube. Se custodia on-premise y NO se versiona.
#   Generar con: openssl rand -hex 32
PLATE_HMAC_KEY=

# ---- Observabilidad ----
LOG_LEVEL=info
LOG_FORMAT=json
ENVIRONMENT=development
